@{
    Layout = "_AdminLayout";
}

@model List<HigienizeMVC.Models.Comment>

<h1>Painel Administrativo</h1>

<div style="background:#fff3cd;
            border:1px solid #ffe69c;
            padding:15px;
            margin-bottom:20px;
            border-radius:8px;">

    <h3>🔔 Comentários Pendentes: @ViewBag.PendingCount</h3>

    @if (ViewBag.PendingCount == 0)
    {
        <p>Nenhum comentário aguardando aprovação.</p>
    }
</div>

<h2>Comentários Pendentes</h2>

<table border="1" cellpadding="10">
    <tr>
        <th>Nome</th>
        <th>Cidade</th>
        <th>Email</th>
        <th>Mensagem</th>
        <th>Data</th>
        <th>Status</th>
        <th>Ações</th>
    </tr>

    @foreach (var comment in Model)
    {
        <tr>
            <td>@comment.Name</td>
            <td>@comment.City</td>
            <td>@comment.Email</td>
            <td>@comment.Message</td>
            <td>@comment.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>

            <td>
                @(comment.IsApprove ? "Aprovado" : "Pendente")
            </td>

            <td>
                <a href="/Admin/ApproveComment/@comment.Id">
                    Aprovar
                </a>

                |

                <a href="/Admin/DeleteComment/@comment.Id">
                    Excluir
                </a>
            </td>
        </tr>
    }
</table>