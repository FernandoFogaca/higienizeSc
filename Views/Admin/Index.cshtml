@model List<HigienizeMVC.Models.Comment>

<h1>Painel Administrativo</h1>

<h2>Comentários</h2>

<table border="1">
    <tr>
        <th>Nome</th>
        <th>Cidade</th>
        <th>Email</th>
        <th>Mensagem</th>
        <th>Data</th>
        <th>Status</th>
        <th>Ações</th>
    </tr>

    @foreach (var comment in Model)
    {
        <tr>
            <td>@comment.Name</td>
            <td>@comment.City</td>
            <td>@comment.Email</td>
            <td>@comment.Message</td>
            <td>@comment.CreatedAt</td>

            <td>
                @(comment.IsApprove ? "Aprovado" : "Pendente")
            </td>
            <td>
    <td>
    <a href="/Admin/ApproveComment/@comment.Id">
        Aprovar
    </a>

    |

    <a href="/Admin/DeleteComment/@comment.Id">
        Negar
    </a>
</td>
</td>
        </tr>
    }
</table>